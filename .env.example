# Synthetic Local/CI defaults only. Copy to .env; never commit real credentials.
POSTGRES_DB=streetsherlock
POSTGRES_USER=streetsherlock
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/streetsherlock
STREETSHERLOCK_API_URL=http://127.0.0.1:8080
